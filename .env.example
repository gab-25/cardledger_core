# Copy to .env and adjust the values you need. All variables are optional;
# the values below are suitable for local development.
# Variables already set in the environment take precedence over .env.

# --- Django ---
# Required in production: set a long random value. Leave commented out locally
# to use the insecure development key (an empty value would break Django).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated lists
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Enable only behind a reverse proxy that terminates HTTPS and sets X-Forwarded-Proto
DJANGO_BEHIND_HTTPS_PROXY=false
# Where uploaded files (the business logo) are stored; empty means ./media
DJANGO_MEDIA_ROOT=

# --- PostgreSQL ---
POSTGRES_DB=cardledger
POSTGRES_USER=cardledger
POSTGRES_PASSWORD=cardledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Catalog files (S3, generated by cardledger_database) ---
# Only these variables are used (never AWS_*). Read access to the bucket is enough (s3:GetObject and s3:ListBucket).
CARDLEDGER_CATALOG_BUCKET=
# Only for S3-compatible storage; empty means AWS
CARDLEDGER_CATALOG_ENDPOINT=
# Empty means us-east-1; "auto" for Cloudflare R2
CARDLEDGER_CATALOG_REGION=
CARDLEDGER_CATALOG_ACCESS_KEY_ID=
CARDLEDGER_CATALOG_SECRET_ACCESS_KEY=

# --- Celery (catalog sync worker) ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Docker Compose only ---
APP_PORT=8000
GUNICORN_WORKERS=2
REDIS_PORT=6379
